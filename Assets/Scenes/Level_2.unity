        \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0437\u0430\u043C\u043E\u043A,
        \u043C\u044B \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 5098025523678261444, guid: dbbf7367ed9960d4bb060a1407e1c0da,
        type: 3}
