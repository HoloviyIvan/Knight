    - target: {fileID: 5098025523678261444, guid: dbbf7367ed9960d4bb060a1407e1c0da,
        type: 3}
      propertyPath: dialogue.sentences.Array.data[0]
      value: "\u0422\u0435\u0431\u044F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0438!!! 
        \n\u042D\u0442\u043E\u0442 \u0437\u0430\u043C\u043E\u043A \u041F\u0420\u041E\u041A\u041B\u042F\u0422!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 5098025523678261444, guid: dbbf7367ed9960d4bb060a1407e1c0da,
        type: 3}
      propertyPath: dialogue.sentences.Array.data[1]
      value: "\u0412 \u043D\u0435\u043C \u043E\u0436\u0438\u0432\u0430\u044E\u0442
        \u0442\u0435\u043D\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 5098025523678261444, guid: dbbf7367ed9960d4bb060a1407e1c0da,
        type: 3}
      propertyPath: dialogue.sentences.Array.data[2]
      value: "\u041A\u0442\u043E \u0443\u0441\u043F\u0435\u043B, \u0443\u0431\u0435\u0436\u0430\u043B\u0438
        \u0438\u0437 \u0437\u0430\u043C\u043A\u0430, \u0430 \u043A\u0442\u043E \u043D\u0435\u0442...
        \u0438\u0445 \u043F\u043E\u0433\u043B\u0430\u0442\u0438\u043B\u0438 \u0442\u0435\u043D\u0438!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 5098025523678261444, guid: dbbf7367ed9960d4bb060a1407e1c0da,
        type: 3}
